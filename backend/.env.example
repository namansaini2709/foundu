# Application
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true for a local webhook test: prevents cron, embedding backfill, and AI matchmaker jobs.
DISABLE_BACKGROUND_JOBS=true

# Meta WhatsApp Cloud API
# Generate a long random value yourself; use exactly the same value in Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
# Copy these from Meta App Dashboard > WhatsApp > API Setup. Never commit real values.
META_ACCESS_TOKEN=replace-with-your-meta-access-token
META_PHONE_NUMBER_ID=replace-with-your-phone-number-id
META_APP_SECRET=replace-with-your-meta-app-secret
TEST_WHATSAPP_RECIPIENT=919876543210
# Use only for the phone demo script; skips embeddings and AI matching.
WHATSAPP_ONBOARDING_DEMO_MODE=true
# Keep this configurable because Meta retires Graph API versions.
META_GRAPH_API_VERSION=v26.0

# Required only when testing resume uploads in the onboarding flow.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
